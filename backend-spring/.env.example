# Spring Boot backend configuration
SERVER_PORT=8001

# Uses the Postgres service from the root docker-compose.yml.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/ecommerce
SPRING_DATASOURCE_USERNAME=user
SPRING_DATASOURCE_PASSWORD=password

# Change this in production. Use a long random value.
JWT_SECRET=change-this-secret-to-a-very-long-random-value-please
JWT_EXPIRATION_MINUTES=30

# Seed demo data on first empty database.
SEED_DATABASE=true

# Frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional: enables real AI generation for segment and flow endpoints.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local avatar upload path.
UPLOAD_DIR=uploads/avatars
